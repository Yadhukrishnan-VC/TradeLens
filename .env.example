# --- Docker Compose (docker-compose.yml reads these; copy this file to .env, never commit .env) ---
POSTGRES_PASSWORD=change-me
# 1 = built-in synthetic prices (plumbing demo only, proves nothing about edge)
TRADELENS_DEMO=0
# signal_only | semi_auto | auto
TRADELENS_MODE=semi_auto
STARTING_CAPITAL=100000
# required by compose; generate with `python -m tradelens token`
API_TOKEN=

# --- Alerts (all optional, all free) ---
# Telegram: create a bot with @BotFather, message it once, then put its token and your chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook that receives every alert as JSON
ALERT_WEBHOOK_URL=
# e.g. a healthchecks.io check URL, pinged after each successful daily run
HEALTHCHECK_PING_URL=

# --- Daily worker ---
# run-daily time (IST), default 16:30
DAILY_RUN_AT=
# plain file with one YYYY-MM-DD holiday per line; put it at data/holidays.txt and set HOLIDAYS_FILE=/app/data/holidays.txt
HOLIDAYS_FILE=
# years of history re-downloaded each run (15 gives longer backtests)
REFRESH_YEARS=15

# --- Live screener (free) ---
# 1 = during NSE hours, check every stock against every strategy using free Yahoo intraday prices
LIVE_SCREENER=1
LIVE_INTERVAL_SECONDS=300

# --- Running without Docker ---
# SQLite for a quick local try, PostgreSQL for real use: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///tradelens.db
# db = prices stored in the database (fetch them on the Data page) | csv = read SYMBOL.csv files from DATA_DIR
DATA_SOURCE=db
DATA_DIR=data
BROKER=paper

# --- Decision support ---
# auto = the gate ENFORCES in auto mode (no human approves) and only ADVISES in semi_auto / signal_only.
# off | advisory | enforce override that. A held-back signal is still recorded and shown; no order follows.
GATE_MODE=auto
# Stored symbol that tells the market regime (fetch it once: python -m tradelens fetch --symbols NIFTYBEES)
BENCHMARK_SYMBOL=NIFTYBEES
# 1 = a strategy outside its usual market regime is held back, not just flagged
ENFORCE_REGIME=0
# An event (results, policy day) within this many days of a signal makes it risky
EVENT_WINDOW_DAYS=2
# A "proven" verdict older than this many days no longer counts
VALIDATION_MAX_AGE_DAYS=45
