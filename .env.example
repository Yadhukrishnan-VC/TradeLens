# --- Docker Compose (docker-compose.yml reads these; copy this file to .env) ---
POSTGRES_PASSWORD=change-me
# 1 = built-in synthetic prices (plumbing demo only, proves nothing about edge)
TRADELITE_DEMO=0
# signal_only | semi_auto | auto
TRADELITE_MODE=semi_auto
STARTING_CAPITAL=100000
# required by compose; set in .env with `python -m tradelite token`
API_TOKEN=
# optional free phone alerts: create a bot with @BotFather, message it once, then put its token and your chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: e.g. a healthchecks.io check URL
ALERT_WEBHOOK_URL=
# run-daily cron (IST), default 16:30
DAILY_RUN_AT=
# comma-separated YYYY-MM-DD holidays; put file at data/holidays.txt and set HOLIDAYS_FILE
HOLIDAYS_FILE=
# years of history to refresh each day
REFRESH_YEARS=5

# --- Live screener (free) ---
# 1 = during NSE hours, check every stock against every strategy using free Yahoo intraday prices
LIVE_SCREENER=1
LIVE_INTERVAL_SECONDS=300
# Optional free phone alerts: create a bot with @BotFather, message it once, then put its token and your chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Running without Docker ---
# SQLite for a quick local try, PostgreSQL for real use: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///tradelite.db
# db = prices stored in the database (fetch them on the Data page) | csv = read SYMBOL.csv files from DATA_DIR
DATA_SOURCE=db
DATA_DIR=data
BROKER=paper
