+def test_exit_hints(name, cols, expected):
+    st = registry.get(name)
+    hint = st.exit_hint(_prepared(**cols), 29, 100.0)
+    if expected is None:
+        assert hint is None
+    else:
+        assert hint is not None and hint.action == expected[0] and expected[1] in hint.reason
