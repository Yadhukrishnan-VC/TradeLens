+def _g(mode="enforce", **kw):
+    base = dict(state="active", rank="proven", fit_updated_at=datetime(2024, 1, 1), today=date(2024, 1, 10), has_event=False, off_regime=False)
+    return gate.evaluate(GateConfig(mode), **{**base, **kw})
+
